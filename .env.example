# Database
DATABASE_URL="postgresql://oakcloud:oakcloud_password@localhost:5433/oakcloud?schema=public"
# Dedicated disposable database used only by destructive PostgreSQL integration tests.
# Never point this at the ordinary development or production database.
TEST_DATABASE_URL="postgresql://oakcloud:oakcloud_password@localhost:5433/oakcloud_stage3_test?schema=public"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Business Assistant is disabled until migration, recovery and review gates pass.
BUSINESS_ASSISTANT_ENABLED=false
BUSINESS_ASSISTANT_PROVIDER_ENABLED=false
BUSINESS_ASSISTANT_MUTATIONS_ENABLED=false
# Optional independent signing secret (32+ characters), shared by all replicas.
# Empty uses JWT_SECRET with a separate cryptographic purpose. Rotation expires
# outstanding BizFile preparation signatures; prepare those proposals again.
BUSINESS_ASSISTANT_PREPARATION_SECRET=""
JWT_EXPIRES_IN="7d"

# AI Providers (for BizFile extraction and other AI features)
# Configure at least one of these to enable AI-powered features
# OpenAI (GPT models)
OPENAI_API_KEY="sk-your-openai-api-key"
# Anthropic (Claude models)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"
# Google (Gemini models)
GOOGLE_AI_API_KEY="your-google-ai-api-key"
# Mistral OCR (used by BizFile and document extraction OCR flows)
MISTRAL_API_KEY=""
# OpenRouter (optional - AI models via OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://your-app-domain.com
OPENROUTER_APP_NAME=OakCloud

# Default AI Model (optional - defaults to gpt-5.4-mini if not set)
# Available models: gpt-5.4-mini, gpt-5.4, o4-mini-deep-research, claude-opus-4.6, claude-sonnet-4.6, gemini-3.1, gemini-3-flash
DEFAULT_AI_MODEL="gpt-5.4-mini"

# App
NEXT_PUBLIC_APP_URL="https://service.oakcloud.app"
EMAIL_APP_URL="https://service.oakcloud.app"
NODE_ENV="development"

# Logging
# Log levels (in order of verbosity): silent, error, warn, info, debug, trace
# - silent: No logging
# - error: Only errors
# - warn: Errors + warnings
# - info: Errors + warnings + info (default for production)
# - debug: All above + debug messages (default for development)
# - trace: All above + SQL queries (most verbose)
LOG_LEVEL="debug"

# data.gov.sg ACRA company name availability check
# The form "Company name check" field searches the locally mirrored "ACRA
# Information on Corporate Entities" collection (updated monthly by ACRA,
# kept current by the daily ACRA entity sync task).
# DATAGOV_METADATA_URL: metadata endpoint used to determine the data "as of" date.
# DATAGOV_API_KEY: optional API key for higher rate limits (see data.gov.sg developer guide).
DATAGOV_METADATA_URL="https://api-production.data.gov.sg/v2/public/api/collections/2/metadata"
DATAGOV_API_KEY=""
# DATAGOV_PUBLIC_HOLIDAY_DATASET_ID: optional override for MOM's public holiday
# dataset (default d_8ef23381f9417e4d4254ee8b4dcdb176, "Singapore Public Holidays (consolidated)").
DATAGOV_PUBLIC_HOLIDAY_DATASET_ID=""

# File Upload
MAX_FILE_SIZE="10485760"

# Storage Configuration
# Provider: 's3' for MinIO/AWS S3, 'local' for filesystem
STORAGE_PROVIDER="s3"
STORAGE_LOCAL_PATH="./uploads"

# S3/MinIO Configuration (when STORAGE_PROVIDER=s3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="oakcloud"
S3_ACCESS_KEY="oakcloud"
S3_SECRET_KEY="secret-key"
S3_FORCE_PATH_STYLE="true"
S3_USE_SSL="false"

# S3 Server-Side Encryption (AES256 | aws:kms | none)
# - AES256: SSE-S3 (default, recommended) - Amazon S3 managed keys
# - aws:kms: SSE-KMS - AWS Key Management Service (requires S3_KMS_KEY_ID)
# - none: No server-side encryption (not recommended for production)
S3_ENCRYPTION="AES256"
# S3_KMS_KEY_ID="arn:aws:kms:region:account:key/key-id"  # Required when S3_ENCRYPTION=aws:kms

# MinIO detection (auto-detected if endpoint contains localhost/127.0.0.1/minio)
# Set explicitly if using MinIO with a custom endpoint
# S3_IS_MINIO="true"

# Email Configuration
# Required for sending emails (password reset, user invitations, notifications)
# If not configured, emails will be logged to console in development mode
#
# Supports two providers (Microsoft Graph is preferred if both are configured):
# 1. Microsoft Graph API (recommended for Microsoft 365 users)
# 2. SMTP (fallback for other providers)

# --- Option 1: Microsoft Graph API (Recommended for M365) ---
# Register an app in Azure AD: https://portal.azure.com → App registrations
# Grant "Mail.Send" application permission and admin consent
AZURE_TENANT_ID="your-azure-tenant-id"
AZURE_CLIENT_ID="your-azure-client-id"
AZURE_CLIENT_SECRET="your-azure-client-secret"
EMAIL_FROM_ADDRESS="admin@yourdomain.com"
EMAIL_FROM_NAME="Oakcloud"

# --- Option 2: SMTP (Fallback) ---
# Only used if Microsoft Graph is not configured
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-smtp-username"
# SMTP_PASSWORD="your-smtp-password"
# EMAIL_FROM_ADDRESS="noreply@example.com"
# EMAIL_FROM_NAME="Oakcloud"

# Common SMTP Provider Examples:
#
# Gmail (requires App Password if 2FA enabled):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
#
# Amazon SES:
# SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
# SMTP_PORT="587"
# SMTP_USER="your-ses-smtp-user"
# SMTP_PASSWORD="your-ses-smtp-password"
#
# SendGrid:
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASSWORD="your-sendgrid-api-key"

# Encryption Key (required for encrypting sensitive data like API keys)
# Must be at least 32 characters. Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-32-character-or-longer-encryption-key-here"

# =============================================================================
# TASK SCHEDULER CONFIGURATION
# =============================================================================
# The general-purpose scheduler runs periodic tasks automatically.
# No external cron job needed - tasks run within the application!

# Master switch: Set to "true" to enable the task scheduler
SCHEDULER_ENABLED="true"

# --- Backup Task ---
# Checks for due backup schedules and processes them
SCHEDULER_BACKUP_ENABLED="true"
# How often to check for due backups (default: every 15 minutes)
SCHEDULER_BACKUP_CRON="0,15,30,45 * * * *"

# --- ACRA Entity Sync Task ---
# Keeps the local acra_entity table (used by the form "Company name check")
# in sync with the data.gov.sg ACRA collection. Runs daily and only re-imports
# when the collection's last-updated time changed. The first sync downloads
# ~654 MB across 27 CSV files (roughly 5-15 minutes); run
# `npx tsx scripts/run-acra-sync.ts` to bootstrap before enabling.
SCHEDULER_ACRA_SYNC_ENABLED="false"
SCHEDULER_ACRA_SYNC_CRON="0 3 * * *"

# --- Public Holiday Sync Task ---
# Checks MOM's official Singapore public holidays on data.gov.sg daily. The small
# dataset is downloaded only when it changed, then every active Singapore
# business calendar is synchronized automatically (manual holidays are kept).
SCHEDULER_PUBLIC_HOLIDAY_SYNC_ENABLED="true"
SCHEDULER_PUBLIC_HOLIDAY_SYNC_CRON="0 4 * * *"

# --- Cleanup Task ---
# Cleans up expired backups and marks stale in-progress backups as failed
SCHEDULER_CLEANUP_ENABLED="true"
# When to run cleanup (default: daily at 2 AM)
SCHEDULER_CLEANUP_CRON="0 2 * * *"

# --- Service Agreement Activation Task ---
# Inherits SCHEDULER_ENABLED and claims pending/retryable agreements every minute.
SCHEDULER_SERVICE_AGREEMENT_ACTIVATION_CRON="* * * * *"

# --- E-Signing Completion Recovery Task ---
# Signed PDFs are generated on demand after the final signature. This task inherits
# SCHEDULER_ENABLED and recovers queued or stale completion work every minute.
SCHEDULER_ESIGNING_PDF_GENERATION_CRON="* * * * *"

# =============================================================================
# CLOUDFLARE TUNNEL (for Docker)
# =============================================================================
# Token from Cloudflare Zero Trust dashboard
# Get it from: https://one.dash.cloudflare.com → Networks → Tunnels → Create
CLOUDFLARE_TUNNEL_TOKEN=""

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# When deploying to production, ensure the following:
#
# 1. Security Settings:
#    NODE_ENV="production"
#    JWT_SECRET="<long-random-string>"          # Generate: openssl rand -base64 48
#    ENCRYPTION_KEY="<32-char-hex-string>"      # Generate: openssl rand -hex 32
#
# 2. S3 Storage with SSL & Encryption:
#    S3_ENDPOINT="https://s3.amazonaws.com"     # Use HTTPS
#    S3_USE_SSL="true"
#    S3_ENCRYPTION="AES256"                     # Enable server-side encryption
#    S3_FORCE_PATH_STYLE="false"                # Use virtual-hosted style for AWS
#
# 3. Database with SSL:
#    DATABASE_URL="postgresql://...?sslmode=require"
#
# 4. Cookie Security:
#    Cookies are automatically set to secure=true when NODE_ENV=production
#
# 5. Password Hashing:
#    Uses Argon2id (OWASP recommended) with automatic bcrypt migration
