{
  "name": "oakcloud",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run check:assistant-capabilities && npm run db:generate && node --max-old-space-size=8192 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:chromium": "tsx scripts/smoke-chromium.ts",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "generate:assistant-capabilities": "tsx scripts/generate-business-assistant-registry.mts",
    "check:assistant-capabilities": "tsx scripts/generate-business-assistant-registry.mts --check",
    "business-assistant:worker": "tsx scripts/business-assistant-worker.ts",
    "business-assistant:p16:evidence": "node scripts/business-assistant-p16-evidence.mjs",
    "test:p16:evidence": "vitest run __tests__/scripts/business-assistant-p16-evidence.test.ts",
    "test:business-assistant:postgres": "node scripts/require-business-assistant-test-env.mjs && vitest run __tests__/integration/business-assistant.postgres.test.ts __tests__/integration/business-assistant-authorization.postgres.test.ts __tests__/integration/business-assistant-learning.postgres.test.ts __tests__/integration/business-assistant-correction-concurrency.postgres.test.ts __tests__/integration/business-assistant-bizfile-correction-storage.postgres.test.ts __tests__/integration/bizfile-source-revision.postgres.test.ts __tests__/integration/bizfile-aggregate-revision.postgres.test.ts __tests__/integration/bizfile-operation-reconciliation.postgres.test.ts __tests__/integration/bizfile-effect-executor.postgres.test.ts __tests__/integration/bizfile/bizfile-correction-races.postgres.test.ts --maxWorkers=1",
    "test:stage3:postgres": "vitest run __tests__/integration/service-agreement-activation.postgres.test.ts",
    "test:esigning": "vitest run esigning --exclude \"**/*.postgres.test.ts\"",
    "test:esigning:postgres": "vitest run __tests__/integration/esigning-completion-worker.postgres.test.ts __tests__/integration/esigning-completion-race.postgres.test.ts __tests__/integration/esigning-pdf-unicode.postgres.test.ts __tests__/integration/esigning-issued-artifacts.postgres.test.ts",
    "test:client-services:postgres": "vitest run __tests__/integration/client-service-manual-creation.postgres.test.ts",
    "test:deadlines:postgres": "vitest run __tests__/integration/deadline-reconciliation.postgres.test.ts __tests__/integration/deadline-tenant-isolation.postgres.test.ts",
    "test:deadlines:performance": "vitest run __tests__/integration/deadline-performance.postgres.test.ts",
    "test:billing:postgres": "node scripts/require-billing-test-env.mjs postgres && vitest run __tests__/integration/billing-schedule-backfill.postgres.test.ts __tests__/integration/billing-tracking-integrity.postgres.test.ts __tests__/integration/billing-reconciliation.postgres.test.ts __tests__/integration/billing-tenant-isolation.postgres.test.ts __tests__/integration/manual-deadline-no-billing.postgres.test.ts --maxWorkers=1",
    "test:billing:performance": "node scripts/require-billing-test-env.mjs performance && vitest run __tests__/integration/billing-performance.postgres.test.ts --maxWorkers=1",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate && node scripts/normalize-generated-prisma.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-service-agreement": "tsx scripts/seed-service-agreement-template.ts",
    "db:backfill-contact-canonical-names": "tsx scripts/backfill-contact-canonical-names.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:db:up": "docker compose -f oakcloud_db.yml up -d",
    "docker:db:down": "docker compose -f oakcloud_db.yml down",
    "docker:db:logs": "docker compose -f oakcloud_db.yml logs -f",
    "repair:deadlines": "tsx scripts/remediate-deadline-occurrences.ts",
    "db:seed-oakdoc-migrations": "tsx scripts/migrate-oakdoc-templates.ts",
    "db:migrate-oakdoc-templates": "tsx scripts/migrate-oakdoc-templates.ts",
    "oakdoc:rollout": "tsx scripts/oakdoc-rollout.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@aws-sdk/client-s3": "^3.954.0",
    "@aws-sdk/s3-request-presigner": "^3.954.0",
    "@azure/identity": "^4.13.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@docx-editor.dev/core": "2.21.1",
    "@docx-editor.dev/react": "2.21.1",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^4.1.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@noble/hashes": "^2.0.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.65.1",
    "@tanstack/react-table": "^8.21.2",
    "@tiptap/extension-color": "^3.13.0",
    "@tiptap/extension-font-family": "^3.15.3",
    "@tiptap/extension-link": "^3.12.1",
    "@tiptap/extension-text-align": "^3.15.3",
    "@tiptap/extension-text-style": "^3.13.0",
    "@tiptap/extension-underline": "^3.12.1",
    "@tiptap/pm": "^3.12.1",
    "@tiptap/react": "^3.12.1",
    "@tiptap/starter-kit": "^3.12.1",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "fast-csv": "^4.3.6",
    "fflate": "0.8.3",
    "file-type": "^22.1.1",
    "jose": "^6.1.2",
    "jsonrepair": "^3.13.3",
    "lucide-react": "^0.474.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.4",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.13",
    "openai": "^4.82.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.4.449",
    "pg": "^8.16.3",
    "puppeteer-core": "^24.32.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.13.3",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.3.0",
    "unicode-case-folding": "1.1.1",
    "use-debounce": "^10.0.6",
    "uuid": "^11.0.5",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^27.0.0",
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.13.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.6",
    "jsdom": "^27.3.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
