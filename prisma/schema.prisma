  company                  Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientService            ClientService?       @relation(fields: [clientServiceId], references: [id], onDelete: Restrict)
  rule                     DeadlineRule         @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ruleVersion              DeadlineRuleVersion  @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  businessCalendar         BusinessCalendar?    @relation(fields: [businessCalendarId], references: [id], onDelete: Restrict)
  createdBy                User?                @relation("ServiceCycleCreator", fields: [createdById], references: [id], onDelete: SetNull)
