/// Actual financial periods with their Year(s) of Assessment. The Company FYE
/// month/day stays the recurring preference; these rows are the history.
model CompanyFinancialPeriod {
  id                String                    @id @default(uuid())
  tenantId          String                    @map("tenant_id")
  companyId         String                    @map("company_id")
  periodStart       DateTime                  @map("period_start") @db.Date
  periodEnd         DateTime                  @map("period_end") @db.Date
  /// Explicit basis allocation; empty means the normal mapping (end year + 1).
  yearsOfAssessment Int[]                     @default([]) @map("years_of_assessment")
  provenance        FinancialPeriodProvenance @default(CONFIRMED)
  confirmedAt       DateTime?                 @map("confirmed_at")
  confirmedById     String?                   @map("confirmed_by_id")
  notes             String?                   @db.VarChar(1000)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  tenant            Workspace                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company                   @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, companyId, periodEnd])
  @@index([tenantId, companyId, periodStart])
  @@map("company_financial_periods")
}

/// Why and from when Oakcloud monitors a company's statutory obligations.
/// Independent of billing; overlapping coverage never duplicates deadlines.
model CompanyMonitoringCoverage {
  id                String                   @id @default(uuid())
  tenantId          String                   @map("tenant_id")
  companyId         String                   @map("company_id")
  profile           MonitoringProfile
  source            MonitoringCoverageSource
  agreementId       String?                  @map("agreement_id")
  clientServiceId   String?                  @map("client_service_id")
  monitoringStart   DateTime                 @map("monitoring_start") @db.Date
  monitoringEnd     DateTime?                @map("monitoring_end") @db.Date
  startSource       String                   @map("start_source") @db.VarChar(40)
  reason            String?                  @db.VarChar(1000)
  status            MonitoringCoverageStatus @default(ACTIVE)
  ownerUserId       String?                  @map("owner_user_id")
  endedAt           DateTime?                @map("ended_at")
  endedById         String?                  @map("ended_by_id")
  endedReason       String?                  @map("ended_reason") @db.VarChar(1000)
  createdById       String?                  @map("created_by_id")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  tenant            Workspace                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company                  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  clientService     ClientService?           @relation(fields: [tenantId, clientServiceId, companyId], references: [tenantId, id, companyId], onDelete: Restrict)
  occurrenceLinks   DeadlineOccurrenceCoverageLink[]
  issues            CompanyComplianceIssue[]

  @@unique([tenantId, clientServiceId, profile])
  @@index([tenantId, companyId, status])
  @@index([tenantId, profile, status])
  @@map("company_monitoring_coverages")
}

/// The obligations and periods a client service is contracted to file.
model ClientServiceObligationScope {
  id              String                      @id @default(uuid())
  tenantId        String                      @map("tenant_id")
  companyId       String                      @map("company_id")
  clientServiceId String                      @map("client_service_id")
  obligationCode  String                      @map("obligation_code") @db.VarChar(100)
  periodKey       String                      @map("period_key") @db.VarChar(40)
  confirmation    ObligationScopeConfirmation @default(UNCONFIRMED)
  source          String                      @db.VarChar(40)
  confirmedAt     DateTime?                   @map("confirmed_at")
  confirmedById   String?                     @map("confirmed_by_id")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  tenant          Workspace                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company                     @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  clientService   ClientService               @relation(fields: [tenantId, clientServiceId, companyId], references: [tenantId, id, companyId], onDelete: Restrict)
  occurrenceLinks DeadlineOccurrenceCoverageLink[]

  @@unique([tenantId, clientServiceId, obligationCode, periodKey])
  @@index([tenantId, companyId, obligationCode, periodKey])
  @@map("client_service_obligation_scopes")
}

/// Every reason a company obligation is tracked. Released links keep history.
model DeadlineOccurrenceCoverageLink {
  id              String                        @id @default(uuid())
  tenantId        String                        @map("tenant_id")
  occurrenceId    String                        @map("occurrence_id")
  linkKey         String                        @map("link_key") @db.VarChar(120)
  reason          CoverageLinkReason
  coverageId      String?                       @map("coverage_id")
  deliveryScopeId String?                       @map("delivery_scope_id")
  linkedAt        DateTime                      @default(now()) @map("linked_at")
  releasedAt      DateTime?                     @map("released_at")
  tenant          Workspace                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrence      DeadlineOccurrence            @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  coverage        CompanyMonitoringCoverage?    @relation(fields: [coverageId], references: [id], onDelete: Restrict)
  deliveryScope   ClientServiceObligationScope? @relation(fields: [deliveryScopeId], references: [id], onDelete: Restrict)

  @@unique([occurrenceId, linkKey])
  @@index([tenantId, coverageId])
  @@map("deadline_occurrence_coverage_links")
}

/// Audit trail of who files a company obligation; identity never changes.
model DeadlineResponsibilityChange {
  id                              String                @id @default(uuid())
  tenantId                        String                @map("tenant_id")
  occurrenceId                    String                @map("occurrence_id")
  previousResponsibility          FilingResponsibility? @map("previous_responsibility")
  newResponsibility               FilingResponsibility  @map("new_responsibility")
  previousDeliveryClientServiceId String?               @map("previous_delivery_client_service_id")
  newDeliveryClientServiceId      String?               @map("new_delivery_client_service_id")
  providerName                    String?               @map("provider_name") @db.VarChar(200)
  source                          ResponsibilitySource
  actorId                         String?               @map("actor_id")
  reason                          String?               @db.VarChar(1000)
  createdAt                       DateTime              @default(now()) @map("created_at")
  tenant                          Workspace             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrence                      DeadlineOccurrence    @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurrenceId, createdAt])
  @@map("deadline_responsibility_changes")
}

