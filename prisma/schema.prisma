model DeadlineOccurrence {
  id                 String                   @id @default(uuid())
  tenantId           String                   @map("tenant_id")
  companyId          String                   @map("company_id")
  ownershipScope     DeadlineOwnershipScope   @default(SERVICE) @map("ownership_scope")
  clientServiceId    String?                  @map("client_service_id")
  /// Canonical statutory identity for COMPANY rows (never the due date, filer or rule version).
  obligationCode      String?                 @map("obligation_code") @db.VarChar(100)
  obligationPeriodKey String?                 @map("obligation_period_key") @db.VarChar(40)
  financialPeriodStart DateTime?              @map("financial_period_start") @db.Date
  financialPeriodEnd  DateTime?               @map("financial_period_end") @db.Date
  yearOfAssessment    Int?                    @map("year_of_assessment")
  periodProvisional   Boolean                 @default(false) @map("period_provisional")
  filingResponsibility FilingResponsibility?  @map("filing_responsibility")
  responsibilitySource ResponsibilitySource?  @map("responsibility_source")
  deliveryClientServiceId String?             @map("delivery_client_service_id")
  filingProviderName  String?                 @map("filing_provider_name") @db.VarChar(200)
  responsibilityConfirmedAt DateTime?         @map("responsibility_confirmed_at")
  responsibilityConfirmedById String?         @map("responsibility_confirmed_by_id")
  monitoringOwnerId   String?                 @map("monitoring_owner_id")
  coverageTiming      String?                 @map("coverage_timing") @db.VarChar(20)
  /// Created after its due date: filing status is unknown until evidence is recorded.
  filingStatusUnconfirmed Boolean             @default(false) @map("filing_status_unconfirmed")
  cycleId            String                   @map("cycle_id")
  ruleVersionId      String                   @map("rule_version_id")
  milestoneKey       String                   @map("milestone_key")
  scheduleEntryKey   String                   @default("") @map("schedule_entry_key")
  deadlineType       DeadlineType             @map("deadline_type")
  calculatedDueDate  DateTime                 @map("calculated_due_date") @db.Date
  operativeDueDate   DateTime                 @map("operative_due_date") @db.Date
  dateOverridden     Boolean                  @default(false) @map("date_overridden")
  dateOverride       DateTime?                @map("date_override") @db.Date
  dateOverrideReason String?                  @map("date_override_reason")
  dateOverriddenById String?                  @map("date_overridden_by_id")
  dateOverriddenAt   DateTime?                @map("date_overridden_at")
  status             DeadlineOccurrenceStatus @default(OPEN)
  completedAt        DateTime?                @map("completed_at")
  completedById      String?                  @map("completed_by_id")
  waivedAt           DateTime?                @map("waived_at")
  waivedById         String?                  @map("waived_by_id")
  waiverReason       String?                  @map("waiver_reason")
  cancelledAt        DateTime?                @map("cancelled_at")
  cancelledById      String?                  @map("cancelled_by_id")
  cancellationReason String?                  @map("cancellation_reason")
  notes              String?
  origin             ServiceCycleOrigin       @default(RULE)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  tenant             Workspace                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company            Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientService      ClientService?           @relation(fields: [clientServiceId], references: [id], onDelete: Restrict)
  deliveryClientService ClientService?        @relation("DeadlineOccurrenceDeliveryService", fields: [deliveryClientServiceId], references: [id], onDelete: Restrict)
  cycle              ServiceCycle             @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  coverageLinks      DeadlineOccurrenceCoverageLink[]
  responsibilityChanges DeadlineResponsibilityChange[]
  ruleVersion        DeadlineRuleVersion      @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  dateOverriddenBy   User?                    @relation("DeadlineOccurrenceOverrideActor", fields: [dateOverriddenById], references: [id], onDelete: SetNull)
  completedBy        User?                    @relation("DeadlineOccurrenceCompletionActor", fields: [completedById], references: [id], onDelete: SetNull)
  waivedBy           User?                    @relation("DeadlineOccurrenceWaiverActor", fields: [waivedById], references: [id], onDelete: SetNull)
  cancelledBy        User?                    @relation("DeadlineOccurrenceCancellationActor", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@unique([tenantId, cycleId, milestoneKey, scheduleEntryKey])
  @@index([tenantId, operativeDueDate, status])
  @@index([tenantId, companyId, operativeDueDate, status])
  @@index([tenantId, clientServiceId, operativeDueDate])
  @@index([tenantId, ownershipScope, filingResponsibility])
  @@map("deadline_occurrences")
}

