/** Durable active version pointer for bounded, allowlisted preference and
 * prompt-profile changes. Promotion and rollback update this row atomically;
 * callers never mutate executable code or arbitrary provider configuration. */
model BusinessAssistantLearningActiveTarget {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  targetKey       String    @map("target_key") @db.VarChar(200)
  activeVersion   String    @map("active_version") @db.VarChar(100)
  activeValue     Json?     @map("active_value")
  previousVersion String?   @map("previous_version") @db.VarChar(100)
  previousValue   Json?     @map("previous_value")
  activeChangeId  String?   @map("active_change_id")
  revision        Int       @default(1)
  updatedById     String    @map("updated_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  tenant          Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, targetKey], map: "ba_learning_target_active_key")
  @@index([tenantId, activeVersion], map: "ba_learning_target_active_version_idx")
  @@map("business_assistant_learning_targets")
}

