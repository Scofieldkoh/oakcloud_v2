// Business Assistant foundation. These records are intentionally module-neutral:
// module operation receipts/effects remain owned by the module that implements a
// capability and are referenced through JSON DTOs below.
model BusinessAssistantConversation {
  id          String                              @id @default(uuid())
  tenantId    String                              @map("tenant_id")
  ownerId     String                              @map("owner_id")
  title       String?                             @db.VarChar(200)
  status      BusinessAssistantConversationStatus @default(ACTIVE)
  deletedAt   DateTime?                           @map("deleted_at")
  deletedReason String?                           @map("deleted_reason") @db.VarChar(300)
  createdAt   DateTime                            @default(now()) @map("created_at")
  updatedAt   DateTime                            @updatedAt @map("updated_at")
  tenant      Workspace                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages    BusinessAssistantMessage[]
  runs        BusinessAssistantRun[]

  @@unique([tenantId, id], map: "ba_conversations_tenant_id_id_key")
  @@index([tenantId, ownerId, updatedAt], map: "ba_conversations_owner_updated_idx")
  @@index([tenantId, deletedAt], map: "ba_conversations_deleted_idx")
  @@map("business_assistant_conversations")
}

model BusinessAssistantMessage {
  id              String                         @id @default(uuid())
  tenantId        String                         @map("tenant_id")
  conversationId  String                         @map("conversation_id")
  ownerId         String                         @map("owner_id")
  sequence        Int
  role            BusinessAssistantMessageRole
  type            BusinessAssistantMessageType
  status          BusinessAssistantMessageStatus @default(ACCEPTED)
  content         String?                        @db.VarChar(12000)
  payload         Json?
  resources       Json?
  operationKind   String                         @default("TURN") @map("operation_kind") @db.VarChar(40)
  clientRequestId String?                        @map("client_request_id") @db.VarChar(200)
  bodyHash        String?                        @map("body_hash") @db.VarChar(128)
  claimToken      String?                        @map("claim_token") @db.VarChar(128)
  claimGeneration Int?                           @map("claim_generation")
  leaseExpiresAt  DateTime?                       @map("lease_expires_at")
  availableAt     DateTime                        @default(now()) @map("available_at")
  createdAt       DateTime                        @default(now()) @map("created_at")
  updatedAt       DateTime                        @updatedAt @map("updated_at")
  tenant          Workspace                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation    BusinessAssistantConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade, map: "business_assistant_messages_conversation_fkey")

  @@unique([tenantId, conversationId, sequence], map: "ba_messages_conversation_sequence_key")
  @@unique([tenantId, ownerId, operationKind, clientRequestId], map: "ba_messages_request_key")
  @@index([tenantId, status, availableAt], map: "ba_messages_status_available_idx")
  @@index([tenantId, conversationId, createdAt], map: "ba_messages_conversation_created_idx")
  @@map("business_assistant_messages")
}

model BusinessAssistantRun {
  id                    String                       @id @default(uuid())
  tenantId              String                       @map("tenant_id")
  conversationId        String?                      @map("conversation_id")
  ownerId               String                       @map("owner_id")
  capabilityId          String                       @map("capability_id") @db.VarChar(200)
  capabilityVersion     String                       @map("capability_version") @db.VarChar(40)
  contractVersion       String                       @map("contract_version") @db.VarChar(40)
  schemaVersion         String                       @map("schema_version") @db.VarChar(40)
  input                 Json
  resources             Json
  status                BusinessAssistantRunStatus  @default(DRAFT)
  activeProposalId      String?                      @map("active_proposal_id")
  cancellationRequestedAt DateTime?                 @map("cancellation_requested_at")
  cancellationReason    String?                      @map("cancellation_reason") @db.VarChar(500)
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")
  startedAt             DateTime?                    @map("started_at")
  completedAt           DateTime?                    @map("completed_at")
  tenant                Workspace                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationTenantId  String?                      @map("conversation_tenant_id")
  conversation          BusinessAssistantConversation? @relation(fields: [conversationTenantId, conversationId], references: [tenantId, id], onDelete: SetNull, map: "business_assistant_runs_conversation_fkey")
  items                 BusinessAssistantRunItem[]
  proposals             BusinessAssistantProposal[]
  approvals             BusinessAssistantApproval[]

  @@unique([tenantId, id], map: "ba_runs_tenant_id_id_key")
  @@index([tenantId, ownerId, updatedAt], map: "ba_runs_owner_updated_idx")
  @@index([tenantId, status, updatedAt], map: "ba_runs_status_updated_idx")
  @@map("business_assistant_runs")
}

model BusinessAssistantRunItem {
  id                    String                        @id @default(uuid())
  tenantId              String                        @map("tenant_id")
  runId                 String                        @map("run_id")
  itemKey               String                        @map("item_key") @db.VarChar(200)
  ordinal               Int
  input                 Json
  resources             Json
  lifecycleState        BusinessAssistantItemState   @default(PENDING) @map("lifecycle_state")
  executionOutcome      BusinessAssistantExecutionOutcome @default(NOT_STARTED) @map("execution_outcome")
  reviewOutcome         BusinessAssistantReviewOutcome @default(NOT_REQUIRED) @map("review_outcome")
  requiredEffectStatus  BusinessAssistantEffectStatus @default(NOT_REQUIRED) @map("required_effect_status")
  dispositionReason     String?                       @map("disposition_reason") @db.VarChar(100)
  operationId           String?                       @map("operation_id") @db.VarChar(200)
  receiptRef            Json?                         @map("receipt_ref")
  output                Json?
  activeStage           BusinessAssistantStage?      @map("active_stage")
  activeAttempt         Int?                          @map("active_attempt")
  claimToken            String?                       @map("claim_token") @db.VarChar(128)
  claimGeneration      Int?                          @map("claim_generation")
  leaseExpiresAt        DateTime?                     @map("lease_expires_at")
  availableAt           DateTime                      @default(now()) @map("available_at")
  retryCount            Int                           @default(0) @map("retry_count")
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")
  tenant                Workspace                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run                   BusinessAssistantRun         @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Cascade, map: "business_assistant_run_items_run_fkey")
  steps                 BusinessAssistantRunStep[]
  reviews               BusinessAssistantReview[]

  @@unique([tenantId, runId, itemKey], map: "ba_run_items_run_item_key")
  @@unique([tenantId, id], map: "ba_run_items_tenant_id_id_key")
  @@index([tenantId, lifecycleState, availableAt], map: "ba_run_items_state_available_idx")
  @@index([tenantId, runId, ordinal], map: "ba_run_items_run_ordinal_idx")
  @@index([tenantId, claimToken, claimGeneration], map: "ba_run_items_claim_idx")
  @@map("business_assistant_run_items")
}

model BusinessAssistantRunStep {
  id              String                        @id @default(uuid())
  tenantId        String                        @map("tenant_id")
  runItemId       String                        @map("run_item_id")
  stage           BusinessAssistantStage
  attemptNumber   Int                           @map("attempt_number")
  status          BusinessAssistantAttemptStatus @default(RUNNING)
  inputArtifact   Json?                         @map("input_artifact")
  outputArtifact  Json?                         @map("output_artifact")
  error           Json?
  providerRef     String?                       @map("provider_ref") @db.VarChar(200)
  claimToken      String?                       @map("claim_token") @db.VarChar(128)
  claimGeneration Int?                          @map("claim_generation")
  startedAt       DateTime                      @default(now()) @map("started_at")
  completedAt     DateTime?                     @map("completed_at")
  nextRetryAt     DateTime?                     @map("next_retry_at")
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")
  tenant          Workspace                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runItem         BusinessAssistantRunItem      @relation(fields: [tenantId, runItemId], references: [tenantId, id], onDelete: Cascade, map: "business_assistant_run_steps_item_fkey")

  @@unique([tenantId, runItemId, stage, attemptNumber], map: "ba_run_steps_attempt_key")
  @@index([tenantId, stage, status, nextRetryAt], map: "ba_run_steps_stage_status_idx")
  @@index([tenantId, runItemId, startedAt], map: "ba_run_steps_item_started_idx")
  @@map("business_assistant_run_steps")
}

