  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Workspace        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar    BusinessCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)

