model BizFileOperationReceipt {
  id                       String                    @id @default(uuid())
  tenantId                 String                    @map("tenant_id")
  operationId              String                    @map("operation_id") @db.VarChar(200)
  capabilityId             String                    @map("capability_id") @db.VarChar(200)
  capabilityVersion        String                    @map("capability_version") @db.VarChar(40)
  schemaVersion            String                    @map("schema_version") @db.VarChar(40)
  mode                     BizFileOperationMode
  companyId                String?                   @map("company_id")
  documentId               String?                   @map("document_id")
  payloadHash              String                    @map("payload_hash") @db.VarChar(128)
  expectedAggregateRevision Int                      @map("expected_aggregate_revision")
  beforeRevision           Int?                      @map("before_revision")
  afterRevision            Int?                      @map("after_revision")
  status                   BizFileOperationStatus
  effectStatus             BizFileOperationEffectStatus @default(NOT_REQUIRED) @map("effect_status")
  safeError                Json?                     @map("safe_error")
  committedAt              DateTime?                 @map("committed_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  tenant                   Workspace                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evidence                 BizFileOperationEvidence[]
  effects                  BizFileOperationEffectIntent[]

  @@unique([tenantId, operationId], map: "bizfile_operation_receipts_operation_key")
  @@unique([tenantId, id], map: "bizfile_operation_receipts_tenant_id_id_key")
  @@index([tenantId, companyId], map: "bizfile_operation_receipts_company_idx")
  @@index([tenantId, documentId], map: "bizfile_operation_receipts_document_idx")
  @@index([tenantId, status, effectStatus], map: "bizfile_operation_receipts_status_idx")
  @@map("bizfile_operation_receipts")
}

model BizFileOperationEvidence {
  id            String                    @id @default(uuid())
  tenantId      String                    @map("tenant_id")
  receiptId     String                    @map("receipt_id")
  kind          BizFileOperationEvidenceKind
  artifact      Json
  artifactHash  String                    @map("artifact_hash") @db.VarChar(128)
  sourceRef     Json?                     @map("source_ref")
  createdAt     DateTime                  @default(now()) @map("created_at")
  tenant        Workspace                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  receipt       BizFileOperationReceipt   @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "bizfile_operation_evidence_receipt_fkey")

  @@unique([tenantId, receiptId, kind], map: "bizfile_operation_evidence_kind_key")
  @@index([tenantId, receiptId, createdAt], map: "bizfile_operation_evidence_receipt_idx")
  @@map("bizfile_operation_evidence")
}

model BizFileOperationEffectIntent {
  id           String                    @id @default(uuid())
  tenantId     String                    @map("tenant_id")
  receiptId    String                    @map("receipt_id")
  effectKind   String                    @map("effect_kind") @db.VarChar(100)
  target       String                    @db.VarChar(500)
  payload      Json?
  payloadHash  String?                   @map("payload_hash") @db.VarChar(128)
  state        BizFileOperationEffectState @default(PENDING)
  attemptCount Int                       @default(0) @map("attempt_count")
  nextAttemptAt DateTime?                @map("next_attempt_at")
  lastError    Json?                      @map("last_error")
  claimToken   String?                    @map("claim_token") @db.VarChar(128)
  claimGeneration Int?                   @map("claim_generation")
  leaseExpiresAt DateTime?                @map("lease_expires_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  tenant       Workspace                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  receipt      BizFileOperationReceipt   @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "bizfile_operation_effect_intents_receipt_fkey")

  @@unique([tenantId, receiptId, effectKind, target], map: "bizfile_operation_effect_target_key")
  @@index([tenantId, state, nextAttemptAt], map: "bizfile_operation_effect_state_idx")
  @@index([tenantId, receiptId], map: "bizfile_operation_effect_receipt_idx")
  @@map("bizfile_operation_effect_intents")
}

