  coverage       CompanyMonitoringCoverage? @relation(fields: [coverageId], references: [id], onDelete: SetNull)

  @@unique([tenantId, companyId, dedupeKey])
  @@index([tenantId, resolvedAt, type])
  @@map("company_compliance_issues")
}

