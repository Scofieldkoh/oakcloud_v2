generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id                               String                                 @id @default(uuid())
  name                             String
  slug                             String                                 @unique
  status                           WorkspaceStatus                        @default(PENDING_SETUP)
  contactEmail                     String?
  contactPhone                     String?
  settings                         Json?
  maxUsers                         Int                                    @default(50)
  maxCompanies                     Int                                    @default(100)
  maxStorageMb                     Int                                    @default(10240)
  logoUrl                          String?
  primaryColor                     String?                                @default("#294d44")
  createdAt                        DateTime                               @default(now())
  updatedAt                        DateTime                               @updatedAt
  deletedAt                        DateTime?
  deletedReason                    String?
  activatedAt                      DateTime?
  suspendedAt                      DateTime?
  suspendReason                    String?
  aiConversations                  AiConversation[]
  auditLogs                        AuditLog[]
  backupSchedule                   BackupSchedule?
  chartOfAccounts                  ChartOfAccount[]
  companies                        Company[]
  companySharePointFolders         CompanySharePointFolder[]
  connectorUsageLogs               ConnectorUsageLog[]
  connectors                       Connector[]
  contactDetails                   ContactDetail[]
  contacts                         Contact[]
  documentTemplates                DocumentTemplate[]
  documents                        Document[]
  exchangeRates                    ExchangeRate[]
  formFields                       FormField[]
  formOptionPresets                FormOptionPreset[]
  formUrlHealth                    FormUrlHealth[]
  formDrafts                       FormDraft[]
  formSubmissions                  FormSubmission[]
  formUploads                      FormUpload[]
  forms                            Form[]
  generatedDocuments               GeneratedDocument[]
  esigningSharePointFilings        EsigningSharePointFiling[]
  esigningEmailDeliveries          EsigningEmailDelivery[]
  esigningEnvelopes                EsigningEnvelope[]
  taskEsigningPreparations         TaskEsigningPreparation[]
  roles                            Role[]
  templatePartials                 TemplatePartial[]
  serviceFamilies                  ServiceFamily[]
  serviceVariants                  ServiceVariant[]
  serviceVariantFeeTemplates       ServiceVariantFeeTemplate[]
  serviceAgreements                ServiceAgreement[]
  serviceAgreementEntities         ServiceAgreementEntity[]
  serviceAgreementItems            ServiceAgreementItem[]
  serviceAgreementItemEntities     ServiceAgreementItemEntity[]
  serviceAgreementFeeLines         ServiceAgreementFeeLine[]
  clientServices                   ClientService[]
  clientServiceFeeLines            ClientServiceFeeLine[]
  deadlineRules                    DeadlineRule[]
  deadlineRuleVersions             DeadlineRuleVersion[]
  deadlineRuleParameterDefinitions DeadlineRuleParameterDefinition[]
  deadlineMilestoneTemplates       DeadlineMilestoneTemplate[]
  serviceVariantDeadlineRules      ServiceVariantDeadlineRule[]
  clientServiceDeadlineRules       ClientServiceDeadlineRule[]
  businessCalendars                BusinessCalendar[]
  businessHolidays                 BusinessHoliday[]
  serviceCycles                    ServiceCycle[]
  deadlineOccurrences              DeadlineOccurrence[]
  companyFinancialPeriods          CompanyFinancialPeriod[]
  companyMonitoringCoverages       CompanyMonitoringCoverage[]
  clientServiceObligationScopes    ClientServiceObligationScope[]
  deadlineOccurrenceCoverageLinks  DeadlineOccurrenceCoverageLink[]
  deadlineResponsibilityChanges    DeadlineResponsibilityChange[]
  companyComplianceIssues          CompanyComplianceIssue[]
  billingOccurrences               BillingOccurrence[]
  billingCoverageIssues            BillingCoverageIssue[]
  reconciliationRequests           ServiceScheduleReconciliationRequest[]
  backups                          WorkspaceBackup[]
  connectorAccess                  WorkspaceConnectorAccess[]
  letterhead                       WorkspaceLetterhead?
  users                            User[]
  taskPipelines                    TaskPipeline[]
  taskPipelineVersions             TaskPipelineVersion[]
  taskPipelineStages               TaskPipelineStage[]
  tasks                            Task[]
  taskStages                       TaskStage[]
  taskStageChecklistItems          TaskStageChecklistItem[]
  taskStageOutcomes                TaskStageOutcome[]
  taskCompanyRecoveryContexts      TaskCompanyRecoveryContext[]
  documentGenerationBatches        DocumentGenerationBatch[]
  documentGenerationBatchItems     DocumentGenerationBatchItem[]
  businessAssistantConversations   BusinessAssistantConversation[]
  businessAssistantMessages        BusinessAssistantMessage[]
  businessAssistantRuns            BusinessAssistantRun[]
  businessAssistantRunItems        BusinessAssistantRunItem[]
  businessAssistantRunSteps        BusinessAssistantRunStep[]
  businessAssistantProposals       BusinessAssistantProposal[]
  businessAssistantApprovals       BusinessAssistantApproval[]
  businessAssistantReviews         BusinessAssistantReview[]
  businessAssistantFeedback        BusinessAssistantFeedback[]
  businessAssistantMemories        BusinessAssistantMemory[]
  businessAssistantLearningChanges BusinessAssistantLearningChange[]
  businessAssistantLearningTargets BusinessAssistantLearningActiveTarget[]
  businessAssistantActionRequests  BusinessAssistantActionRequest[]
  bizFileOperationReceipts         BizFileOperationReceipt[]
  bizFileOperationEvidence         BizFileOperationEvidence[]
  bizFileOperationEffects          BizFileOperationEffectIntent[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

model Role {
  id             String               @id @default(uuid())
  tenantId       String?
  name           String
  description    String?
  isSystem       Boolean              @default(false)
  systemRoleType String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  permissions    RolePermission[]
  tenant         Workspace?           @relation(fields: [tenantId], references: [id])
  users          UserRoleAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([systemRoleType])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  resource    String
  action      String
  description String?
  roles       RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  companyId String?
  createdAt DateTime @default(now())
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, companyId])
  @@index([userId])
  @@index([roleId])
  @@index([companyId])
  @@index([userId, roleId, companyId])
  @@map("user_role_assignments")
}

model User {
  id                                   String                                 @id @default(uuid())
  email                                String                                 @unique
  passwordHash                         String
  firstName                            String
  lastName                             String
  isActive                             Boolean                                @default(true)
  lastLoginAt                          DateTime?
  createdAt                            DateTime                               @default(now())
  updatedAt                            DateTime                               @updatedAt
  deletedAt                            DateTime?
  mustChangePassword                   Boolean                                @default(false)
  passwordResetToken                   String?                                @unique
  passwordResetExpires                 DateTime?
  passwordChangedAt                    DateTime?
  tenantId                             String?
  aiConversations                      AiConversation[]                       @relation("ConversationOwner")
  auditLogs                            AuditLog[]
  connectorUsageLogs                   ConnectorUsageLog[]
  hiddenComments                       DocumentComment[]                      @relation("CommentHider")
  resolvedComments                     DocumentComment[]                      @relation("CommentResolver")
  authoredComments                     DocumentComment[]                      @relation("CommentAuthor")
  documentDrafts                       DocumentDraft[]                        @relation("DraftAuthor")
  createdTemplates                     DocumentTemplate[]                     @relation("TemplateCreator")
  uploadedDocuments                    Document[]
  createdDocuments                     GeneratedDocument[]                    @relation("DocumentCreator")
  createdEsigningEnvelopes             EsigningEnvelope[]                     @relation("EsigningEnvelopeCreatedBy")
  initiatedTaskEsigningPreparations    TaskEsigningPreparation[]              @relation("TaskEsigningPreparationInitiator")
  finalizedDocuments                   GeneratedDocument[]                    @relation("DocumentFinalizer")
  createdPartials                      TemplatePartial[]                      @relation("PartialCreator")
  companyAssignments                   UserCompanyAssignment[]
  preferences                          UserPreference[]
  roleAssignments                      UserRoleAssignment[]
  resolvedSharePointFilings            EsigningSharePointFiling[] @relation("SharePointFilingResolver")
  verifiedCompanySharePointFolders     CompanySharePointFolder[]  @relation("CompanySharePointFolderVerifier")
  tenant                               Workspace?                             @relation(fields: [tenantId], references: [id])
  ownedTasks                           Task[]                                 @relation("TaskOwner")
  assignedTaskStages                   TaskStage[]                            @relation("TaskStageAssignee")
  requestedServiceAgreementActivations ServiceAgreement[]                     @relation("ServiceAgreementActivationRequester")
  createdGenerationBatches             DocumentGenerationBatch[]              @relation("DocumentGenerationBatchCreator")
  createdDeadlineRules                 DeadlineRule[]                         @relation("DeadlineRuleCreator")
  updatedDeadlineRules                 DeadlineRule[]                         @relation("DeadlineRuleUpdater")
  archivedDeadlineRules                DeadlineRule[]                         @relation("DeadlineRuleArchiver")
  createdDeadlineRuleVersions          DeadlineRuleVersion[]                  @relation("DeadlineRuleVersionCreator")
  publishedDeadlineRuleVersions        DeadlineRuleVersion[]                  @relation("DeadlineRuleVersionPublisher")
  updatedClientServiceDeadlineRules    ClientServiceDeadlineRule[]            @relation("ClientServiceDeadlineRuleUpdater")
  createdServiceCycles                 ServiceCycle[]                         @relation("ServiceCycleCreator")
  overriddenDeadlineOccurrences        DeadlineOccurrence[]                   @relation("DeadlineOccurrenceOverrideActor")
  completedDeadlineOccurrences         DeadlineOccurrence[]                   @relation("DeadlineOccurrenceCompletionActor")
  waivedDeadlineOccurrences            DeadlineOccurrence[]                   @relation("DeadlineOccurrenceWaiverActor")
  cancelledDeadlineOccurrences         DeadlineOccurrence[]                   @relation("DeadlineOccurrenceCancellationActor")
  overriddenBillingOccurrenceDates     BillingOccurrence[]                    @relation("BillingOccurrenceDateOverrideActor")
  overriddenBillingOccurrenceValues    BillingOccurrence[]                    @relation("BillingOccurrenceValueOverrideActor")
  markedBilledBillingOccurrences       BillingOccurrence[]                    @relation("BillingOccurrenceBilledActor")
  waivedBillingOccurrences             BillingOccurrence[]                    @relation("BillingOccurrenceWaiverActor")
  cancelledBillingOccurrences          BillingOccurrence[]                    @relation("BillingOccurrenceCancellationActor")
  requestedScheduleReconciliations     ServiceScheduleReconciliationRequest[] @relation("ScheduleReconciliationRequester")

  @@index([email])
  @@index([tenantId])
  @@index([passwordResetToken])
  @@index([tenantId, deletedAt, isActive])
  @@index([deletedAt, isActive])
  @@map("users")
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preferences")
}

model PerformanceMeasurement {
  id         String   @id @default(uuid())
  route      String
  metricType String   @map("metric_type")
  value      Decimal  @db.Decimal(18, 4)
  unit       String
  metadata   Json?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([route, metricType, createdAt])
  @@index([createdAt])
  @@map("performance_measurements")
}

model UserCompanyAssignment {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("user_company_assignments")
}

model Company {
  id                          String                       @id @default(uuid())
  tenantId                    String
  uen                         String
  name                        String
  displayAlias                String?                      @map("display_alias") @db.VarChar(10)
  formerName                  String?
  dateOfNameChange            DateTime?
  entityType                  EntityType                   @default(PRIVATE_LIMITED)
  status                      CompanyStatus                @default(LIVE)
  statusDate                  DateTime?
  incorporationDate           DateTime?
  registrationDate            DateTime?
  dateOfAddress               DateTime?
  primarySsicCode             String?
  primarySsicDescription      String?
  secondarySsicCode           String?
  secondarySsicDescription    String?
  financialYearEndDay         Int?
  financialYearEndMonth       Int?
  fyeAsAtLastAr               DateTime?
  homeCurrency                String?                      @default("SGD")
  lastAgmDate                 DateTime?
  lastArFiledDate             DateTime?
  accountsDueDate             DateTime?
  paidUpCapitalCurrency       String?                      @default("SGD")
  paidUpCapitalAmount         Decimal?                     @db.Decimal(18, 2)
  issuedCapitalCurrency       String?                      @default("SGD")
  issuedCapitalAmount         Decimal?                     @db.Decimal(18, 2)
  hasCharges                  Boolean                      @default(false)
  currentOfficerCount         Int                          @default(0) @map("current_officer_count")
  currentShareholderCount     Int                          @default(0) @map("current_shareholder_count")
  activeChargeCount           Int                          @default(0) @map("active_charge_count")
  documentCount               Int                          @default(0) @map("document_count")
  hasPoc                      Boolean                      @default(false) @map("has_poc")
  isGstRegistered             Boolean                      @default(false)
  gstRegistrationNumber       String?
  gstRegistrationDate         DateTime?
  isRegisteredCharity         Boolean                      @default(false)
  charityRegistrationDate     DateTime?
  charityUEN                  String?
  isIPC                       Boolean                      @default(false)
  ipcEffectiveDate            DateTime?
  ipcExpiryDate               DateTime?
  annualReceiptsOrExpenditure Decimal?                     @db.Decimal(18, 2)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  aggregateRevision           Int                          @default(0) @map("aggregate_revision")
  deletedAt                   DateTime?
  deletedReason               String?
  taskIntegrationContext      Json?                        @map("task_integration_context")
  auditLogs                   AuditLog[]
  chartOfAccounts             ChartOfAccount[]
  accountMappings             ChartOfAccountsMapping[]
  tenant                      Workspace                    @relation(fields: [tenantId], references: [id])
  clientServices              ClientService[]
  addresses                   CompanyAddress[]
  auditor                     CompanyAuditor?
  charges                     CompanyCharge[]
  contacts                    CompanyContact[]
  formerNames                 CompanyFormerName[]
  officers                    CompanyOfficer[]
  shareholders                CompanyShareholder[]
  contactDetails              ContactDetail[]
  documentTags                DocumentTag[]
  documents                   Document[]
  esigningEnvelopes           EsigningEnvelope[]
  generatedDocuments          GeneratedDocument[]
  noteTabs                    NoteTab[]
  shareCapital                ShareCapital[]
  userAssignments             UserCompanyAssignment[]
  roleAssignments             UserRoleAssignment[]
  tasks                       Task[]
  taskStageOutcomes           TaskStageOutcome[]
  taskRecoveryContexts        TaskCompanyRecoveryContext[]
  primaryServiceAgreements    ServiceAgreement[]           @relation("ServiceAgreementPrimaryCompany")
  serviceAgreementEntities    ServiceAgreementEntity[]
  primaryGenerationBatches    DocumentGenerationBatch[]    @relation("DocumentGenerationBatchPrimaryCompany")
  serviceCycles               ServiceCycle[]
  deadlineOccurrences         DeadlineOccurrence[]
  financialPeriods            CompanyFinancialPeriod[]
  monitoringCoverages         CompanyMonitoringCoverage[]
  obligationScopes            ClientServiceObligationScope[]
  complianceIssues            CompanyComplianceIssue[]
  billingOccurrences          BillingOccurrence[]
  billingCoverageIssues       BillingCoverageIssue[]
  sharePointFolderMapping     CompanySharePointFolder?
  esigningSharePointFilings   EsigningSharePointFiling[]

  @@unique([tenantId, uen])
  @@unique([tenantId, id], map: "companies_tenant_id_id_key")
  @@index([tenantId])
  @@index([uen])
  @@index([name])
  @@index([status])
  @@index([entityType])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([accountsDueDate])
  @@index([status, accountsDueDate])
  @@index([tenantId, status])
  @@index([tenantId, currentOfficerCount])
  @@index([tenantId, currentShareholderCount])
  @@index([tenantId, activeChargeCount])
  @@index([tenantId, documentCount])
  @@index([tenantId, hasPoc])
  @@map("companies")
}

model CompanySharePointFolder {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  companyId       String    @unique @map("company_id")
  connectorId     String    @map("connector_id")
  driveId         String    @map("drive_id")
  folderItemId    String    @map("folder_item_id")
  folderName      String    @map("folder_name")
  folderWebUrl    String    @map("folder_web_url")
  lastVerifiedAt  DateTime? @map("last_verified_at")
  verifiedById    String?   @map("verified_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  tenant          Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connector       Connector @relation(fields: [connectorId], references: [id], onDelete: Restrict)
  verifiedBy      User?     @relation("CompanySharePointFolderVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, connectorId, driveId, folderItemId])
  @@index([tenantId, companyId])
  @@index([connectorId, driveId, folderItemId])
  @@map("company_sharepoint_folders")
}

model CompanyFormerName {
  id               String    @id @default(uuid())
  companyId        String
  formerName       String
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  sourceDocumentId String?
  createdAt        DateTime  @default(now())
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document         Document? @relation(fields: [sourceDocumentId], references: [id])

  @@index([companyId])
  @@map("company_former_names")
}

model CompanyAddress {
  id               String      @id @default(uuid())
  companyId        String
  addressType      AddressType
  block            String?
  streetName       String
  level            String?
  unit             String?
  buildingName     String?
  postalCode       String
  country          String      @default("SINGAPORE")
  fullAddress      String
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  isCurrent        Boolean     @default(true)
  sourceDocumentId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document         Document?   @relation(fields: [sourceDocumentId], references: [id])

  @@index([companyId])
  @@index([addressType])
  @@index([isCurrent])
  @@index([companyId, isCurrent])
  @@index([companyId, isCurrent, addressType])
  @@map("company_addresses")
}

model Contact {
  id                          String               @id @default(uuid())
  tenantId                    String
  contactType                 ContactType          @default(INDIVIDUAL)
  firstName                   String?
  lastName                    String?
  fullName                    String
  canonicalName               String?
  alias                       String?
  canonicalAlias              String?
  identificationType          IdentificationType?
  identificationNumber        String?
  nationality                 String?
  dateOfBirth                 DateTime?
  corporateName               String?
  corporateUen                String?
  fullAddress                 String?
  isActive                    Boolean              @default(true)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  deletedAt                   DateTime?
  chargeHoldings              CompanyCharge[]
  companyRelations            CompanyContact[]
  officerPositions            CompanyOfficer[]
  shareholdings               CompanyShareholder[]
  contactDetails              ContactDetail[]
  tenant                      Workspace            @relation(fields: [tenantId], references: [id])
  noteTabs                    NoteTab[]

  @@unique([tenantId, identificationType, identificationNumber])
  @@index([tenantId])
  @@index([fullName])
  @@index([identificationNumber])
  @@index([corporateUen])
  @@index([tenantId, deletedAt])
  @@index([tenantId, contactType, isActive])
  @@index([tenantId, contactType, deletedAt, canonicalName])
  @@index([tenantId, contactType, deletedAt, canonicalAlias])
  @@map("contacts")
}

model CompanyContact {
  id           String    @id @default(uuid())
  companyId    String
  contactId    String
  relationship String
  isPrimary    Boolean   @default(false)
  isPoc        Boolean   @default(false)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([companyId, contactId, relationship])
  @@index([companyId])
  @@index([contactId])
  @@index([deletedAt])
  @@map("company_contacts")
}

model ContactDetail {
  id           String            @id @default(uuid())
  tenantId     String
  contactId    String?
  companyId    String?
  detailType   ContactDetailType
  value        String
  label        String?
  purposes     String[]          @default([])
  description  String?
  displayOrder Int               @default(0)
  isPrimary    Boolean           @default(false)
  isPoc        Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  company      Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant       Workspace         @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([contactId])
  @@index([companyId])
  @@index([detailType])
  @@index([tenantId, contactId])
  @@index([tenantId, companyId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, detailType, deletedAt])
  @@map("contact_details")
}

model CompanyOfficer {
  id                   String              @id @default(uuid())
  companyId            String
  contactId            String?
  role                 OfficerRole
  name                 String
  identificationType   IdentificationType?
  identificationNumber String?
  nationality          String?
  address              String?
  appointmentDate      DateTime?
  cessationDate        DateTime?
  isCurrent            Boolean             @default(true)
  sourceDocumentId     String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact              Contact?            @relation(fields: [contactId], references: [id])
  document             Document?           @relation(fields: [sourceDocumentId], references: [id])

  @@index([companyId])
  @@index([contactId])
  @@index([role])
  @@index([isCurrent])
  @@index([companyId, isCurrent])
  @@index([contactId, companyId])
  @@index([name, isCurrent])
  @@index([companyId, isCurrent, appointmentDate])
  @@map("company_officers")
}

model ShareCapital {
  id               String    @id @default(uuid())
  companyId        String
  shareClass       String    @default("ORDINARY")
  currency         String    @default("SGD")
  numberOfShares   Int
  parValue         Decimal?  @db.Decimal(18, 4)
  totalValue       Decimal   @db.Decimal(18, 2)
  isPaidUp         Boolean   @default(true)
  isTreasury       Boolean   @default(false)
  effectiveDate    DateTime?
  sourceDocumentId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document         Document? @relation(fields: [sourceDocumentId], references: [id])

  @@index([companyId])
  @@index([companyId, effectiveDate(sort: Desc)])
  @@map("share_capital")
}

model CompanyAuditor {
  id               String    @id @default(uuid())
  companyId        String    @unique
  name             String
  address          String?
  appointmentDate  DateTime?
  sourceDocumentId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document         Document? @relation(fields: [sourceDocumentId], references: [id])

  @@index([sourceDocumentId])
  @@map("company_auditors")
}

model CompanyShareholder {
  id                   String              @id @default(uuid())
  companyId            String
  contactId            String?
  name                 String
  shareholderType      ContactType         @default(INDIVIDUAL)
  isNominee            Boolean             @default(false)
  identificationType   IdentificationType?
  identificationNumber String?
  nationality          String?
  placeOfOrigin        String?
  address              String?
  shareClass           String              @default("ORDINARY")
  numberOfShares       Int
  percentageHeld       Decimal?            @db.Decimal(5, 2)
  currency             String              @default("SGD")
  allotmentDate        DateTime?
  transferDate         DateTime?
  isCurrent            Boolean             @default(true)
  sourceDocumentId     String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact              Contact?            @relation(fields: [contactId], references: [id])
  document             Document?           @relation(fields: [sourceDocumentId], references: [id])

  @@index([companyId])
  @@index([contactId])
  @@index([isCurrent])
  @@index([companyId, isCurrent])
  @@index([contactId, companyId])
  @@index([name, isCurrent])
  @@index([companyId, isCurrent, numberOfShares])
  @@map("company_shareholders")
}

model CompanyCharge {
  id                String    @id @default(uuid())
  companyId         String
  chargeHolderId    String?
  chargeNumber      String?
  chargeType        String?
  description       String?
  chargeHolderName  String
  amountSecured     Decimal?  @db.Decimal(18, 2)
  amountSecuredText String?
  currency          String?   @default("SGD")
  registrationDate  DateTime?
  dischargeDate     DateTime?
  isFullyDischarged Boolean   @default(false)
  sourceDocumentId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
