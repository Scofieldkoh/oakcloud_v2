  feeLine                ClientServiceFeeLine    @relation(fields: [tenantId, feeLineId, clientServiceId], references: [tenantId, id, clientServiceId], onDelete: Restrict)
  dateOverriddenBy       User?                   @relation("BillingOccurrenceDateOverrideActor", fields: [dateOverriddenById], references: [id], onDelete: Restrict)
  valueOverriddenBy      User?                   @relation("BillingOccurrenceValueOverrideActor", fields: [valueOverriddenById], references: [id], onDelete: Restrict)
  markedBilledBy         User?                   @relation("BillingOccurrenceBilledActor", fields: [markedBilledById], references: [id], onDelete: Restrict)
  waivedBy               User?                   @relation("BillingOccurrenceWaiverActor", fields: [waivedById], references: [id], onDelete: Restrict)
  cancelledBy            User?                   @relation("BillingOccurrenceCancellationActor", fields: [cancelledById], references: [id], onDelete: Restrict)
